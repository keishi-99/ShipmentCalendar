<Window x:Class="ShipmentCalendar.Views.DepartmentLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="部署別 締切集中度" Height="500" Width="1450"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="Bold"
                   Text="部署別 締切集中度" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="表示中の注文の未完了工程について、必要時間を営業日に按分し、日別・部署別に集計しています。充足率は、合計必要時間÷(実働人数×1日の稼働時間)で算出します。実働人数は基本人数から日別欠員数を差し引いた人数です。"/>

        <TextBlock DockPanel.Dock="Bottom" Name="TxtEmpty" Margin="0,8,0,0" Foreground="#666666"
                   Text="表示中の注文に未完了工程がありません。" Visibility="Collapsed"/>

        <TextBlock DockPanel.Dock="Top" Name="TxtHeadcountWarning" Margin="0,0,0,8" Foreground="#B00020" TextWrapping="Wrap"
                   Text="基本人数が未設定の部署があります。「欠員」画面で基本人数を設定すると、その部署の充足率による集中度判定が有効になります。" Visibility="Collapsed"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{StaticResource CongestionCaution}" CornerRadius="3" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="やや集中" Foreground="Black"/>
            </Border>
            <TextBlock Text="：充足率" VerticalAlignment="Center"/>
            <TextBox Name="TxtCautionPercent" Width="60" Margin="4,0" Padding="2" VerticalContentAlignment="Center"/>
            <TextBlock Text="%以上　　" VerticalAlignment="Center"/>
            <Border Background="{StaticResource CongestionConcentrated}" CornerRadius="3" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="集中" Foreground="Black"/>
            </Border>
            <TextBlock Text="：充足率" VerticalAlignment="Center"/>
            <TextBox Name="TxtConcentratedPercent" Width="60" Margin="4,0" Padding="2" VerticalContentAlignment="Center"/>
            <TextBlock Text="%以上" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="適用" Padding="12,4" Click="BtnApplyThreshold_Click"/>
        </StackPanel>

        <!--  セルクリック時に該当注文一覧を表示する固定幅のサイドパネル  -->
        <!--  DockPanelはLastChildFill既定でTrueのため、サイドパネルより後ろにDataGridを置いて
              DataGridが実質的な最後の子要素（残りスペースを埋める要素）になるようにする  -->
        <Border DockPanel.Dock="Right" Width="260" Margin="12,0,0,0" Padding="8"
                Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Name="TxtDetailTitle" FontWeight="Bold" Margin="0,0,0,4"
                           TextWrapping="Wrap" Text="日付セルを選択すると明細を表示します"/>
                <ListBox Name="CellDetailList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="CellDetailList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Cursor="Hand" ToolTip="ダブルクリックで注文詳細を表示">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding ManufactureNumber}"/>
                                <!--  品目名・工程名・所要時間をすべて固定幅にして行ごとに位置を揃え、
                                      はみ出す場合は末尾を省略表示する（全文はツールチップで確認可能）  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10" Text="{Binding ProductName, Mode=OneWay}" Foreground="#666666"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName, Mode=OneWay}" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" FontSize="10" Text="{Binding ProcessName, Mode=OneWay}" Foreground="#666666"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName, Mode=OneWay}" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="2" FontSize="10" Text="{Binding RequiredTimeText, Mode=OneWay}" Foreground="#666666"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DataGrid Name="LoadGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1" SelectionUnit="Cell">
            <!--  セル選択時も非選択時と同じ見た目のままにする（ハイライト無効化）  -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="部署" Binding="{Binding DepartmentDisplayText}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
