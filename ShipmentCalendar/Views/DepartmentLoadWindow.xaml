<Window x:Class="ShipmentCalendar.Views.DepartmentLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="部署別 締切集中度" Height="650" Width="1450"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="Bold"
                   Text="部署別 締切集中度" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="全注文（区分フィルターで絞り込み可能）の未完了工程について、必要時間を営業日に按分し、日別・部署別に集計しています。充足率は、合計必要時間÷(実働人数×1日の稼働時間)で算出します。実働人数は基本人数から日別欠員数を差し引いた人数です。"/>

        <TextBlock DockPanel.Dock="Bottom" Name="TxtEmpty" Margin="0,8,0,0" Foreground="#666666"
                   Text="対象の注文に未完了工程がありません。" Visibility="Collapsed"/>

        <TextBlock DockPanel.Dock="Top" Name="TxtHeadcountWarning" Margin="0,0,0,8" Foreground="#B00020" TextWrapping="Wrap"
                   Text="基本人数が未設定の部署があります。「欠員」画面で基本人数を設定すると、その部署の充足率による集中度判定が有効になります。" Visibility="Collapsed"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="区分：" VerticalAlignment="Center"/>
            <ComboBox Name="CmbCategory" Width="160" Margin="4,0,16,0" VerticalContentAlignment="Center"
                      SelectionChanged="CmbCategory_SelectionChanged"/>
            <Border Background="{StaticResource CongestionCaution}" CornerRadius="3" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="やや集中" Foreground="Black"/>
            </Border>
            <TextBlock Text="：充足率" VerticalAlignment="Center"/>
            <TextBox Name="TxtCautionPercent" Width="60" Margin="4,0" Padding="2" VerticalContentAlignment="Center"/>
            <TextBlock Text="%以上　　" VerticalAlignment="Center"/>
            <Border Background="{StaticResource CongestionConcentrated}" CornerRadius="3" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="集中" Foreground="Black"/>
            </Border>
            <TextBlock Text="：充足率" VerticalAlignment="Center"/>
            <TextBox Name="TxtConcentratedPercent" Width="60" Margin="4,0" Padding="2" VerticalContentAlignment="Center"/>
            <TextBlock Text="%以上" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="適用" Padding="12,4" Click="BtnApplyThreshold_Click"/>
        </StackPanel>

        <!--  カレンダーと下部の明細パネルの高さをGridSplitterでドラッグ可能にするため、
              この部分だけDockPanelのDock指定ではなくGrid行ベースのレイアウトにする  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <DataGrid Name="LoadGrid" Grid.Row="0"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto" FrozenColumnCount="2" SelectionUnit="Cell"
                      CurrentCellChanged="LoadGrid_CurrentCellChanged">
                <!--  セル選択時も非選択時と同じ見た目のままにする（ハイライト無効化）  -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="部署" Binding="{Binding DepartmentDisplayText}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!--  締切を過ぎても未完了の工程は日別セルに含めず、ここに部署単位で集計する（クリックで明細表示）  -->
                    <DataGridTemplateColumn Header="超過" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  固定列（部署・超過）とスクロールする日付列の境界を、既存の配色（今日＝青、超過＝赤）と衝突しない
                                      無彩色・太めの線で明示する  -->
                                <Border ToolTip="{Binding OverdueTooltip}"
                                        BorderBrush="#999999" BorderThickness="0,0,2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource StatusOverdue}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OverdueCountText}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OverdueHoursText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="6" Margin="0,4"
                          Background="#CCCCCC" Cursor="SizeNS"/>

            <!--  セルクリック時に該当注文一覧を表示する下部パネル（DataGridなので列幅は自動で揃う）  -->
            <Border Grid.Row="2" Padding="8"
                    Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Name="TxtDetailTitle" FontWeight="Bold" Margin="0,0,0,4"
                               TextWrapping="Wrap" Text="日付セルを選択すると明細を表示します"/>
                    <DataGrid Name="CellDetailGrid" AlternatingRowBackground="#F5F5F5" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                              MouseDoubleClick="CellDetailGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="CenterCellText" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="当日分" Binding="{Binding DayMinutesText}" SortMemberPath="DayMinutes" Width="70" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="全体" Binding="{Binding TotalMinutesText}" SortMemberPath="Process.RequiredMinutes" Width="70" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="進捗" Binding="{Binding ProgressText}" Width="70" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="製番" Binding="{Binding ManufactureNumber}" Width="200" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="品目名" Binding="{Binding ProductName}" Width="250" ElementStyle="{StaticResource CenterCellText}"/>
                            <DataGridTextColumn Header="工程名" Binding="{Binding ProcessName}" Width="*" MinWidth="140" ElementStyle="{StaticResource CenterCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
